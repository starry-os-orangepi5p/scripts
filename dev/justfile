# Default recipe to display help
default:
    @echo "You should create a soft link to this file in repo root dir to use"
    @just --list

sync:
    repo sync -j 8

# Build the project (LOG=debug MODE=debug BACKTRACE=y by default)
build LOG="debug" MODE="debug" BACKTRACE="y":
    @echo "Building project with LOG={{LOG}} MODE={{MODE}} BACKTRACE={{BACKTRACE}}..."
    LOG={{LOG}} MODE={{MODE}} BACKTRACE={{BACKTRACE}} bash $STARRY_ROOT/dev/build.sh

# Build and push to git
build-push LOG="debug" MODE="debug" BACKTRACE="y":
    @echo "Building and pushing with LOG={{LOG}} MODE={{MODE}} BACKTRACE={{BACKTRACE}}..."
    LOG={{LOG}} MODE={{MODE}} BACKTRACE={{BACKTRACE}} bash $STARRY_ROOT/dev/build.sh push

