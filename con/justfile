# Default recipe to display help
default:
    @echo "You should create a soft link to this file in repo root dir to use"
    @just --list

# Initialize the ethernet configuration
init:
    bash ${STARRY_CON_SCRIPT}/con/set_en.sh

# Build the project
build:
    @echo "Building project..."
    bash ${STARRY_CON_SCRIPT}/con/build.sh

flash_boot:
    @echo "Flashing boot..."
    bash ${STARRY_CON_SCRIPT}/con/flash_boot.sh

# Run build then flash boot
opi:
    @echo "Running build and flashing boot..."
    just build flash_boot

# Flash rootfs
flash_rootfs:
    @echo "Flashing rootfs..."
    bash ${STARRY_CON_SCRIPT}/con/flash_rootfs.sh

# Flash uimage
flash:
    @echo "Flashing rootfs..."
    bash ${STARRY_CON_SCRIPT}/con/flash.sh

# Prepare rootfs
prepare_rootfs:
    @echo "Preparing rootfs..."
    bash ${STARRY_CON_SCRIPT}/con/prepare_rootfs.sh

# Update scripts
update_scripts:
    @echo "Updating scripts..."
    bash ${STARRY_CON_SCRIPT}/con/update_scripts.sh

# Clean build artifacts
clean:
    @echo "Cleaning build artifacts..."
    # Add your clean commands here

# Run tests
test:
    @echo "Running tests..."
    # Add your test commands here
